  "platforms": {
    "claude-code": {
      "id": "claude-code",
      "display_name": "Claude Code",
      "vendor": "Anthropic",
      "last_verified": "2026-10-19",
      "source_url": "https://code.claude.com/docs/en/skills",
      "status": "verified",
      "invocation_syntax": "/<skill-name>",
      "reload_behavior": "Watches skill folders; changes apply in-session without restart",
      "hot_reload": true,
      "symlink_supported": true,
      "reserved_names": [
        "synced"
      ],
      "project_skill_paths": [
        ".claude/skills"
      ],
      "user_skill_paths": {
        "macos": "~/.claude/skills",
        "linux": "~/.claude/skills",
        "windows": "%USERPROFILE%\\.claude\\skills"
      },
      "detection_rules": {
        "project_dirs": [
          ".claude"
        ],
        "user_dirs": [
          "~/.claude"
        ],
        "binaries": [
          "claude"
        ]
      },
      "supported_frontmatter_fields": [
        "name",
        "description",
        "allowed-tools",
        "disable-model-invocation",
        "user-invocable",
        "argument-hint",
        "context",
        "agent"
      ],
      "ignored_frontmatter_fields": [
        "license",
        "compatibility",
        "metadata"
      ],
      "notes": "Does not expand ${CLAUDE_SKILL_DIR} in other tools. Cloud sessions do not read ~/.claude/skills/."
    },
    "cursor": {
